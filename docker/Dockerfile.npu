# Runtime-only image for NPU environment.
# Uses Debian (glibc) because libdcmi.so is glibc-linked and cannot run on Alpine (musl).
FROM debian:bookworm-slim

ARG DEBIAN_MIRROR="http://mirrors.aliyun.com/debian"
RUN if [ -n "${DEBIAN_MIRROR}" ]; then \
      case "${DEBIAN_MIRROR}" in \
        http://?*|https://?*) ;; \
        *) echo "invalid DEBIAN_MIRROR" >&2; exit 2 ;; \
      esac; \
      mirror_location="${DEBIAN_MIRROR#*://}"; \
      case "${mirror_location}" in \
        ''|*@*|*\?*|*\#*|*[[:space:]]*) \
          echo "invalid DEBIAN_MIRROR location" >&2; exit 2 ;; \
      esac; \
      case "${DEBIAN_MIRROR}" in \
        */debian|*/debian/) ;; \
        *) echo "DEBIAN_MIRROR must end in /debian" >&2; exit 2 ;; \
      esac; \
      root="${DEBIAN_MIRROR%/}"; \
      security_root="${root%/debian}/debian-security"; \
      for source_file in \
        /etc/apt/sources.list \
        /etc/apt/sources.list.d/*.list \
        /etc/apt/sources.list.d/*.sources; do \
        [ -f "${source_file}" ] || continue; \
        sed -i \
          -e "s#http://deb.debian.org/debian-security#${security_root}#g" \
          -e "s#https://deb.debian.org/debian-security#${security_root}#g" \
          -e "s#http://deb.debian.org/debian#${root}#g" \
          -e "s#https://deb.debian.org/debian#${root}#g" \
          "${source_file}"; \
      done; \
    fi \
    && apt-get update && apt-get install -y --no-install-recommends \
    bash \
    docker.io \
    ipmitool \
    smartmontools \
    util-linux \
    dmidecode \
    pciutils \
    && rm -rf /var/lib/apt/lists/*

COPY docker/.build/catmonitor /usr/local/bin/catmonitor
COPY docker/.build/dfee /usr/local/bin/dfee
COPY docker/.build/web /usr/local/bin/web
COPY docker/.build/cpu-runner-client /usr/local/bin/catmonitor-stress-cpu-client
COPY docker/catmonitor.yaml /etc/catmonitor/catmonitor.yaml
COPY configs/metrics.yaml /etc/catmonitor/metrics.yaml
COPY features/web/metrics.yaml /features/web/metrics.yaml
COPY features/dfee/metrics.yaml /features/dfee/metrics.yaml
COPY features/health/metrics.yaml /features/health/metrics.yaml
COPY features/dfee/grafana-dashboard.json /features/dfee/grafana-dashboard.json
COPY features/dfee/USAGE.md /features/dfee/USAGE.md

RUN install -d -m 0755 /opt/catmonitor/stress && \
    install -d -m 0750 /var/lib/catmonitor/stress

ENTRYPOINT ["/usr/local/bin/catmonitor", "daemon", "--config", "/etc/catmonitor/catmonitor.yaml"]
